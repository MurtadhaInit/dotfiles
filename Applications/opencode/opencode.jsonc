{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "permission": {
    "bash": {
      "home-manager*": "ask",
      "nix run home-manager*": "ask",
      "tofu apply*": "ask",
      "ansible-playbook*": "ask"
    }
  },
  "mcp": {
    "nushell-mcp": {
      "type": "local",
      "command": ["nu", "--mcp"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  }
}